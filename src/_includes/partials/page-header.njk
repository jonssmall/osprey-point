<div class="border-b border-navy-100 bg-linear-to-b from-navy-50 to-white dark:to-navy-950">
  <div class="mx-auto max-w-6xl px-4 py-8">
    {% if breadcrumbs %}
      <nav aria-label="Breadcrumb" class="no-print mb-3">
        <ol class="flex flex-wrap items-center gap-1 text-sm text-navy-500">
          <li><a href="/" class="text-bay-700 no-underline hover:underline">Home</a></li>
          {% for crumb in breadcrumbs %}
            <li aria-hidden="true" class="px-1">/</li>
            <li>
              <a href="{{ crumb.url }}" class="text-bay-700 no-underline hover:underline"
                >{{ crumb.label }}</a
              >
            </li>
          {% endfor %}
          <li aria-hidden="true" class="px-1">/</li>
          <li class="text-navy-700" aria-current="page">{{ title }}</li>
        </ol>
      </nav>
    {% endif %}

    {% if eyebrow %}
      <p class="text-sm font-semibold uppercase tracking-wide text-bay-700">{{ eyebrow }}</p>
    {% endif %}
    <h1 class="mt-1 text-3xl font-bold sm:text-4xl">{{ title }}</h1>
    {% if lede %}
      <p class="mt-3 max-w-3xl text-lg text-navy-700">{{ lede }}</p>
    {% endif %}
  </div>
</div>
