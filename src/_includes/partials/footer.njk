<footer class="theme-invariant mt-16 border-t-4 border-bay-600 bg-navy-900 text-navy-100">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <h2 class="font-display text-lg font-bold text-white">{{ site.name }}</h2>
      <address class="mt-3 space-y-0.5 text-sm not-italic">
        <div>{{ site.address.line1 }}</div>
        <div>{{ site.address.line2 }}</div>
        <div>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</div>
      </address>
      <dl class="mt-3 space-y-0.5 text-sm">
        <div class="flex gap-2">
          <dt class="text-navy-200">Phone:</dt>
          <dd>{{ site.phone }}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-navy-200">Hours:</dt>
          <dd>{{ site.hours }}</dd>
        </div>
      </dl>
    </div>

    {% for item in navigation %}
      {% if item.children %}
        <nav aria-label="{{ item.label }}">
          <h2 class="font-display text-sm font-bold uppercase tracking-wide text-white">
            {{ item.label }}
          </h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {% for child in item.children %}
              <li>
                <a href="{{ child.url }}" class="text-navy-100 no-underline hover:text-white hover:underline"
                  >{{ child.label }}</a
                >
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    {% endfor %}
  </div>

  <div class="border-t border-navy-700">
    <div class="mx-auto max-w-6xl px-4 py-5 text-xs text-navy-200">
      <p class="rounded border border-navy-700 bg-navy-800 p-3">
        <strong class="text-white">Disclaimer:</strong> {{ site.disclaimer }}
      </p>
      <p class="mt-3">
        &copy; {{ site.incorporated }}&ndash;2026 {{ site.name }} (fictional). Built as a
        front-end demonstration with Eleventy, Vite, and Tailwind CSS.
      </p>
    </div>
  </div>
</footer>
