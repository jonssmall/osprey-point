---
layout: layouts/base.njk
---

{% include "partials/page-header.njk" %}

<div class="mx-auto max-w-6xl px-4 py-10">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <article class="prose-gov">
      {{ content | safe }}
    </article>

    {% if sidebar %}
      <aside class="no-print lg:pt-2">
        <div class="rounded border border-navy-100 bg-navy-50 p-5">
          <h2 class="font-display text-base font-bold text-navy-900">{{ sidebar.heading }}</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {% for link in sidebar.links %}
              <li>
                <a href="{{ link.url }}" class="text-bay-700 no-underline hover:underline"
                  >{{ link.label }}</a
                >
              </li>
            {% endfor %}
          </ul>
        </div>
      </aside>
    {% endif %}
  </div>
</div>
