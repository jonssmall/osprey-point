---
layout: layouts/base.njk
---

<div class="border-b border-navy-100 bg-linear-to-b from-navy-50 to-white dark:to-navy-950">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <nav aria-label="Breadcrumb" class="no-print mb-3 text-sm">
      <a href="/news/" class="text-bay-700 no-underline hover:underline">&larr; All news &amp; alerts</a>
    </nav>
    <p class="text-sm font-semibold uppercase tracking-wide text-bay-700">
      {{ category or "Announcement" }}
    </p>
    <h1 class="mt-1 text-3xl font-bold sm:text-4xl">{{ title }}</h1>
    <p class="mt-3 text-sm text-navy-500">
      Published <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {% if author %} &middot; {{ author }}{% endif %}
    </p>
    {% if lede %}
      <p class="mt-4 text-lg text-navy-700">{{ lede }}</p>
    {% endif %}
  </div>
</div>

<div class="mx-auto max-w-3xl px-4 py-10">
  <article class="prose-gov">
    {{ content | safe }}
  </article>

  {% if contact %}
    <div class="mt-10 rounded border border-navy-100 bg-navy-50 p-5 text-sm">
      <h2 class="font-display text-base font-bold">Media &amp; public inquiries</h2>
      <p class="mt-2 text-navy-700">{{ contact }}</p>
    </div>
  {% endif %}
</div>
